# Throwaway verification scripts and scratch dirs used during development.
# These are written, run once against the dev database, and deleted; ignoring
# them keeps a working tree readable while several workstreams are in flight.
scripts/_tmp_*.ts
scripts/_pt_tmp_*/
.scratch_agent/
.pt-legacy-tmp/

# Agent scratch verification scripts run from the repo root (Playwright needs
# the repo node_modules, so they cannot live in the scratchpad).
.pwcheck.js
.crest-sheet.tsx
.crest-tsconfig.json

# Env files. `.env` is the local dev connection string and must never be
# committed; `.env.example` is the documented template and IS committed.
.env
.env.*
!.env.example

# Vercel CLI
.vercel
scripts/_tmp_*
scripts/_*

# Scratch Playwright drivers written by tooling at the repo root
.pw*.js
shots/
