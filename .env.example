# Copy this file to .env and fill in a real Postgres connection string for
# local development (e.g. a free project from neon.com, or a local Postgres
# install). Not needed for the live Vercel deployment — Vercel's Neon
# integration injects DATABASE_URL directly, it does not read this file.
DATABASE_URL="postgresql://user:password@host:5432/database"

# The same database, but a DIRECT (non-pooled) connection. Prisma runs
# migrations through this one: `migrate deploy` holds a session open to run
# DDL, and a transaction-mode pooler cannot do that — it times out with
# P1002, which is what a Vercel build reports as
# "command npm run build exited with 1".
#
# On Neon the pooled host contains `-pooler` and the direct host does not.
# Neon's Vercel integration already provides the direct one as
# DATABASE_URL_UNPOOLED — copy that value into DIRECT_URL in the Vercel
# project's environment variables.
#
# Locally, with no pooler in front of Postgres, this can be identical to
# DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/database"
