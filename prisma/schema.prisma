// ---------------------------------------------------------------------------
// Gridiron GM — data model
// Postgres via Prisma. Anything stored as a JSON string is noted — those are
// modeled as plain String columns (not Postgres jsonb) so the shape matches
// exactly what lib/json.ts's helpers read and write.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x matches Vercel's serverless function runtime; without
  // it the deployed app can fail at request time with an engine-not-found
  // error even though local dev and the build both succeed.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through the POOLED connection. Serverless opens a
  // connection per invocation, and an unpooled endpoint runs out of them
  // under very light concurrency.
  url       = env("DATABASE_URL")
  // Migrations go DIRECT, and must. `prisma migrate deploy` runs DDL in a
  // session that a transaction-mode pooler (PgBouncer, which is what Neon's
  // `-pooler` host is) cannot hold open — it times out with P1002 rather
  // than failing fast, which is exactly what the first deploys did.
  //
  // Set DIRECT_URL to the same database WITHOUT `-pooler` in the host. Neon's
  // Vercel integration already exposes it as DATABASE_URL_UNPOOLED. Locally
  // it can simply equal DATABASE_URL, since there is no pooler in front of a
  // local Postgres.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// League / season state
// ---------------------------------------------------------------------------

model League {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Which browser owns this save (see lib/owner.ts). Opaque random id from an
  // httpOnly cookie — not authentication, but the boundary that stops one
  // tester from listing or deleting another's franchises on a shared
  // deployment. Nullable for the same reason as startYear below: `prisma db
  // push` cannot add a required column to a database that already has rows.
  // A null here means "created before ownership existed"; lib/owner.ts adopts
  // those in development and hides them in production.
  ownerKey String?

  seasonYear        Int    @default(2025)
  // The season this league was FOUNDED in — the base year capForYear() grows
  // the salary cap from. Nullable ONLY so `prisma db push` can add it to an
  // existing database without a force-reset (adding it as required hard-fails
  // against existing rows, even with --accept-data-loss). Never read it
  // directly: lib/leagueYear.ts's resolveStartYear() derives and persists a
  // value for any save created before this column existed.
  startYear         Int?
  week              Int    @default(1) // 1..REGULAR_SEASON_WEEKS during the season
  // Phase machine (see lib/season.ts): PRESEASON | REGULAR | PLAYOFFS | OFFSEASON
  // | RESIGN | FREE_AGENCY | DRAFT | FANTASY_DRAFT
  phase             String @default("PRESEASON")
  // The league year the CONTRACT ledger has already been stepped onto (see
  // ageContractsForYear in lib/season.ts). Contracts are aged the moment the
  // season ends rather than three offseason steps later, so dead money and
  // cap hits always describe the same league year a cut booked right now is
  // charged against — that mismatch is what made an early cut cost more than
  // an identical late one. Nullable so `prisma db push` can add it to an
  // existing database, and so a save created before this column existed still
  // gets its aging run by the offseason AGE_CONTRACTS catch-up step.
  contractsAgedYear Int?
  // The league year the user was last warned that advancing out of RESIGN
  // would drop his roster below the legal minimum. The warning blocks the
  // advance ONCE per year and then gets out of the way — letting players walk
  // is a legitimate choice, losing two thirds of a roster without being told
  // is not. Nullable for the same `prisma db push` reason as the column above.
  resignWarnedYear  Int?

  userTeamId String?

  // The ACCOUNT that owns this save, once it has been claimed (see
  // docs/accounts.md and lib/owner.ts). Null means "still owned by a browser
  // cookie alone" — ownerKey above stays the mechanism for a signed-out
  // player, and is what the claim matches on.
  //
  // Nullable because `migrate deploy` runs against a database with live rows,
  // every one of which predates accounts. SetNull rather than Cascade on
  // purpose: deleting a user must never delete their dynasties. The save falls
  // back to being cookie-owned, which is recoverable; a cascade is not.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Full settings blob (see lib/settings.ts -> LeagueSettings). JSON string.
  settings String

  teams          Team[]
  players        Player[]
  games          Game[]
  picks          DraftPick[]
  transactions   Transaction[]
  draftState     DraftState?
  tradeOffers    TradeOffer[]
  seasonRecords  TeamSeasonRecord[]
  leagueRecords  LeagueRecord[]
  playerSeasons  PlayerSeason[]
  powerSnapshots PowerRankingSnapshot[]
  tradeRecords   TradeRecord[]
  dynasty        DynastyProfile?
  negotiations   NegotiationTalks[]

  // The home-page list filters on one of these two every time, and the claim
  // is `WHERE ownerKey = $1 AND userId IS NULL`.
  @@index([userId])
  @@index([ownerKey])
}

model DraftState {
  id       String @id @default(cuid())
  leagueId String @unique
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  // "ROOKIE" (annual rookie draft) or "FANTASY" (league-start blank-roster draft)
  kind      String  @default("ROOKIE")
  round     Int     @default(1)
  pickIndex Int     @default(0) // 0-based index into the full serialized pick order
  // Serialized array of teamIds in pick order. JSON string.
  order     String  @default("[]")
  complete  Boolean @default(false)
  // Has the GM actually opened this draft? startRookieDraft writes the row the
  // moment free agency closes, and the live ticker used to start burning AI
  // picks as soon as the draft page rendered — so the first round happened
  // while the owner was still reading the phase summary. The row now exists in
  // a "board set, clock not running" state until beginRookieDraftAction flips
  // this (see app/actions/draft.ts).
  //
  // ROOKIE drafts only. A fantasy draft is the thing the user asked for by
  // creating the league, so there is nothing to gate — draftIsStarted() in
  // lib/draft.ts is the single place that rule lives, and it is what the app
  // reads rather than this column directly.
  //
  // The migration that added it backfills every EXISTING row to true. A save
  // sitting on the clock mid-draft when this shipped would otherwise have
  // taken the @default(false) and frozen: no button on its screen, no ticker.
  started   Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Teams & staff
// ---------------------------------------------------------------------------

model Team {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  city       String
  nickname   String
  abbr       String
  conference String // "AFC" | "NFC" (generic: "EAST CONF" style names are fine)
  division   String // "East" | "North" | "South" | "West"
  isUser     Boolean @default(false)

  // Team identity / AI personality --------------------------------------------
  prestige  Int    @default(50) // 0-100, drives FA attraction. PLACEHOLDER weight.
  offScheme String @default("Balanced") // see lib/tuning.ts SCHEMES
  defScheme String @default("4-3 Base")
  // AI GM personality knobs, JSON string: { aggression, winNow, valueDraftPicks, ... }
  gmProfile String @default("{}")

  // Season record --------------------------------------------------------------
  wins        Int     @default(0)
  losses      Int     @default(0)
  ties        Int     @default(0)
  pointsFor   Int     @default(0)
  pointsAgnst Int     @default(0)
  divWins     Int     @default(0)
  divLosses   Int     @default(0)
  confWins    Int     @default(0)
  confLosses  Int     @default(0)
  playoffSeed Int?
  eliminated  Boolean @default(false)

  // Scouting economy (see lib/scoutingEconomy.ts) ------------------------------
  // Focus is a finite per-period allowance, not a growing pile. `scoutPeriod`
  // is the period key (year/phase/week) the current allowance was granted for;
  // when the league moves past it the balance is topped up and any unspent
  // carry-over above SCOUT_ECONOMY.CARRY_CAP_FRACTION of the new grant is lost.
  scoutPoints      Int @default(0) // unspent focus right now
  scoutPeriod      Int @default(0) // period key of the last replenishment (0 = never)
  scoutPeriodGrant Int @default(0) // size of the grant that opened this period (UI shows "x of y")
  scoutSpentSeason Int @default(0) // focus burned so far this league year, for the department UI

  players         Player[]
  staff           Staff[]
  scouts          Scout[]
  homeGames       Game[]                 @relation("HomeTeam")
  awayGames       Game[]                 @relation("AwayTeam")
  ownedPicks      DraftPick[]            @relation("PickOwner")
  originalPicks   DraftPick[]            @relation("PickOrigin")
  reports         ScoutingReport[]
  depthChart      DepthChartSlot[]
  tradeOffersFrom TradeOffer[]
  seasonRecords   TeamSeasonRecord[]
  playerSeasons   PlayerSeason[]
  shortlist       ShortlistEntry[]
  negotiations    NegotiationTalks[]
  powerSnapshots  PowerRankingSnapshot[]

  @@index([leagueId])
}

model Staff {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role          String // "HC" | "OC" | "DC" | "ST"
  name          String
  // 0-100 ratings. PLACEHOLDER: exact impact curves live in lib/tuning.ts
  rating        Int    @default(50)
  playCalling   Int    @default(50) // in-game boost to unit score
  development   Int    @default(50) // offseason progression boost
  scheme        String @default("Balanced")
  contractYears Int    @default(3)
  salary        Int    @default(3000000)

  @@index([teamId])
}

model Scout {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name      String
  // 0-100. Higher accuracy => narrower scouted ranges, faster confidence gain.
  accuracy  Int    @default(50)
  speed     Int    @default(50) // scouting points generated per week
  // Position group this scout is best at: "OL" | "SKILL" | "FRONT7" | "SECONDARY" | "ALL"
  specialty String @default("ALL")
  salary    Int    @default(500000)

  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Players
// ---------------------------------------------------------------------------

model Player {
  id       String  @id @default(cuid())
  leagueId String
  league   League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  firstName  String
  lastName   String
  position   String // QB RB WR TE LT LG C RG RT EDGE DT LB CB S K P
  age        Int
  experience Int    @default(0) // completed pro seasons
  heightIn   Int    @default(73)
  weightLb   Int    @default(220)
  college    String @default("State")

  // TRUE ratings — never shown directly unless settings.revealTrueRatings ------
  // JSON string map of attributeKey -> 0..99 (see lib/ratings.ts ATTRIBUTES)
  trueAttrs String
  trueOvr   Int // cached overall from trueAttrs at current position
  potential Int // 0..99 ceiling
  devTrait  String @default("Normal") // Slow | Normal | Star | Superstar

  // Draft / status -------------------------------------------------------------
  status      String  @default("ACTIVE") // ACTIVE | INJURED | FREE_AGENT | RETIRED | ROOKIE_POOL
  isDraftee   Boolean @default(false) // in the current rookie/fantasy pool
  draftYear   Int?
  draftRound  Int?
  draftPickNo Int?

  // College scouting profile — only meaningful while isDraftee is true.
  // JSON strings (see lib/gen/prospectProfile.ts CollegeProfile / CombineTesting).
  collegeStats   String @default("{}")
  combineTesting String @default("{}")

  // Coaching/development focus charges bought with scouting focus points.
  // Each charge multiplies the next in-season development checkpoint roll and
  // is consumed by it (see lib/development.ts). 0 for every existing save.
  devFocus Int @default(0)

  // Consecutive offseasons this player has spent unsigned. Drives the
  // out-of-football attrition roll in lib/development.ts — without it the free
  // agent pool only ever grew, because nothing off a roster aged or retired.
  // Reset to 0 the moment he signs anywhere.
  yearsUnsigned Int @default(0)

  // Consecutive WEEKS on the wire — every advance of the league clock while he
  // is unsigned, whatever the phase. This is the clock his asking price falls
  // on (askingPrice in lib/cap.ts): a good player nobody has signed by
  // September takes less than he wanted in April, and by midseason he is
  // signing for a fraction of it.
  //
  // WHY THIS EXISTS ALONGSIDE yearsUnsigned RATHER THAN REUSING IT. The yearly
  // counter moves in one lump during the offseason PROGRESS step, which has
  // nothing to do with when a man actually hit the market: somebody released in
  // the playoffs would be stamped "a year unsigned" four weeks later and his
  // price would fall off a cliff for a reason that is not about him, while
  // somebody released the week after PROGRESS sits at zero for a full calendar
  // year. Weeks are the honest clock, and they are also the only one that moves
  // WITHIN a season — which is exactly the window a GM watches a released star
  // sit unsigned in. yearsUnsigned keeps doing its own job (attrition) and this
  // one prices him; the migration that added this column seeded it from
  // yearsUnsigned so saves written before it existed do not quote a
  // three-years-unsigned player his April number.
  //
  // Zeroed at both ends of a stint: by signFreeAgent when somebody takes him,
  // and by cutPlayer when he is released, so it always means "weeks since he
  // last hit the wire" rather than "weeks he has ever spent unsigned".
  weeksUnsigned Int @default(0)

  injuryWeeks Int     @default(0)
  injuryType  String? // human-readable description, e.g. "Hamstring strain" — set when injured, cleared on recovery
  fatigue     Int     @default(0) // 0-100, restores between weeks
  morale      Int     @default(70) // 0-100. PLACEHOLDER effect on re-sign odds.

  // Season stat accumulators, JSON string (see lib/types.ts SeasonStats).
  //
  // REGULAR SEASON AND POSTSEASON ARE SEPARATE BUCKETS, deliberately. They
  // used to share one: simulateAndSaveGame gates only the STANDINGS on
  // kind === 'REGULAR', so a Super Bowl run silently added up to four games
  // of production — and four games of `gp` — to the season totals of the
  // twelve clubs that got there and none of the twenty that did not. League
  // leaders then ranked a 21-game back against a 17-game back on one list,
  // which rewards making the playoffs rather than playing well, and career
  // totals inherited it. Two buckets, one meaning each.
  //
  // seasonStats/careerStats are REGULAR SEASON ONLY — that is the convention
  // every real football reference uses when it says "career stats", and it is
  // what every ranking, award and record in this codebase wants.
  seasonStats String @default("{}")
  careerStats String @default("{}")

  // The same two accumulators for postseason games only (WILDCARD through
  // FINAL). Rolled over on the identical schedule as the pair above.
  playoffStats       String @default("{}")
  careerPlayoffStats String @default("{}")

  contract      Contract?
  reports       ScoutingReport[]
  depthSlots    DepthChartSlot[]
  draftPick     DraftPick?
  shortlistedBy ShortlistEntry[]
  negotiations  NegotiationTalks[]
  seasons       PlayerSeason[]

  @@index([leagueId])
  @@index([teamId])
  @@index([position])

  /// Every league-wire row about him — signings, releases, draft day, awards.
  transactions Transaction[]
}

// ---------------------------------------------------------------------------
// Scouting fog-of-war
// ---------------------------------------------------------------------------

model ScoutingReport {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // 0..100. Drives how tight the displayed range is around the true value.
  confidence Int    @default(0)
  // Per-attribute noisy observations, JSON string: { attrKey: observedValue }
  // The displayed range is observed +/- error(confidence). Observations are
  // resampled (and re-centered) as confidence rises. See lib/scouting.ts
  observed   String @default("{}")
  // Cached scouted overall + range for list views
  scoutedOvr Int    @default(0)
  ovrLow     Int    @default(0)
  ovrHigh    Int    @default(99)
  notes      String @default("")
  // Period key (see lib/scoutingEconomy.ts periodKey) of the most recent pass.
  lastWeek   Int    @default(0)

  // Scouting economy bookkeeping ----------------------------------------------
  // Total passes ever run on this player by this team. Drives BOTH the cost
  // escalation and the reveal decay, so hammering one prospect gets steadily
  // more expensive and steadily less informative.
  passes        Int     @default(0)
  // Passes run inside the current period only — reset whenever lastWeek moves.
  periodPasses  Int     @default(0)
  // Potential has its own confidence track: only a Deep Dive pushes it above
  // the general confidence, which is what makes the deep tier worth its price.
  potConfidence Int     @default(0)
  // JSON array of attribute keys locked to their true value by an evaluation.
  attrsRevealed String  @default("[]")
  // True once a Deep Dive surfaced the player's hidden development trait.
  devRevealed   Boolean @default(false)
  // Set ONLY by the Dynasty "Full Scout" ability (lib/dynasty.ts). When true,
  // buildScoutedView returns the player's TRUE attributes and an exact
  // potential — the one sanctioned hole in the fog of war, paid for with a
  // per-season charge that is persisted on DynastyProfile so a page reload
  // cannot restore it. Nothing else in the codebase writes this column.
  fullyRevealed Boolean @default(false)
  // League year the Full Scout reveal was bought in — display only ("Fully
  // evaluated, 2027"), never gates the reveal itself: a perfect evaluation
  // you paid for does not expire.
  revealedYear  Int     @default(0)
  // League year a PRIVATE WORKOUT was held on this player by this team (see
  // lib/workouts.ts). Nullable: it is genuinely absent for every report that
  // predates workouts, and `prisma db push` cannot add a required column to a
  // database that already has rows. Two jobs, both of them real: it stops a
  // scarce workout slot being spent twice on the same prospect, and it is
  // what a page reads to say "worked him out in 2027". It does NOT gate the
  // reveal — the reveal lives in the confidence/attrsRevealed columns like
  // every other one.
  workoutYear   Int?

  @@unique([playerId, teamId])
  @@index([teamId])
}

/// A team's personal draft board — prospects flagged to track through the season, independent of scouting confidence.
model ShortlistEntry {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([playerId, teamId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Contracts & cap
// ---------------------------------------------------------------------------

model Contract {
  id       String  @id @default(cuid())
  playerId String  @unique
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String?

  years          Int
  yearsRemaining Int
  signedYear     Int
  // Per-year base salaries, JSON string number[] (index 0 = current year)
  baseSalaries   String
  signingBonus   Int     @default(0) // fully prorated across min(years + voidYears, 5)
  guaranteed     Int     @default(0)
  isRookieDeal   Boolean @default(false)
  isFranchiseTag Boolean @default(false)
  // Cap-only trailing years tacked on (usually via a restructure) purely to
  // spread signing-bonus proration further — the player is never actually
  // on the roster for these. All remaining proration accelerates as dead
  // money the moment the real contract ends or the player is cut.
  voidYears      Int     @default(0)
}

// Dead money left behind by cuts/trades, tracked per team-year.
model CapCharge {
  id     String @id @default(cuid())
  teamId String
  year   Int
  amount Int
  label  String

  @@index([teamId, year])
}

// ---------------------------------------------------------------------------
// Draft
// ---------------------------------------------------------------------------

model DraftPick {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  year           Int
  round          Int
  slot           Int // 1..32 within the round; assigned by reverse standings
  originalTeamId String
  originalTeam   Team   @relation("PickOrigin", fields: [originalTeamId], references: [id], onDelete: Cascade)
  ownerTeamId    String
  ownerTeam      Team   @relation("PickOwner", fields: [ownerTeamId], references: [id], onDelete: Cascade)

  used     Boolean @default(false)
  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([leagueId, year, round, slot])
  @@index([ownerTeamId])
}

// ---------------------------------------------------------------------------
// Depth chart
// ---------------------------------------------------------------------------

model DepthChartSlot {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  position String // depth chart position bucket (QB, RB, WR1..., etc.)
  rank     Int // 0 = starter

  @@unique([teamId, position, rank])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Games
// ---------------------------------------------------------------------------

model Game {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  seasonYear Int
  week       Int
  // REGULAR | WILDCARD | DIVISIONAL | CONFERENCE | FINAL
  kind       String @default("REGULAR")

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  played    Boolean @default(false)
  homeScore Int     @default(0)
  awayScore Int     @default(0)

  // JSON string (see lib/types.ts BoxScore)
  boxScore String @default("{}")
  recap    String @default("")

  @@index([leagueId, seasonYear, week])
}

// ---------------------------------------------------------------------------
// League transaction ledger (signings, cuts, trades, draft picks, injuries)
// ---------------------------------------------------------------------------

model Transaction {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  seasonYear Int
  week       Int
  // SIGN | CUT | TRADE | DRAFT | INJURY | RESIGN | TAG | PROGRESS | NEWS
  // | CHAMPION | FIRE (coordinator fired for a poor record)
  type       String
  teamId     String?

  /// The man this row is ABOUT, when it is about one.
  ///
  /// Every player-shaped transaction — a signing, a release, a draft pick, an
  /// award, an All-Star selection — used to carry his name in `headline` and
  /// nothing else. So the trophy screen had to match the Championship MVP back
  /// to a box line BY NAME to recover a portrait, and the History page, the GM
  /// honours list and the league wire could name a player they could not link
  /// to. A name is not an identity: two men can share one, and a rename or a
  /// format change silently breaks every reader at once.
  ///
  /// Nullable because plenty of rows are not about a player at all (CHAMPION,
  /// FIRE, NEWS, TRADE — which is about two clubs and a package), and because
  /// rows written before this column existed genuinely do not know. Null means
  /// "not known / not applicable", never "no player".
  ///
  /// SetNull rather than Cascade, deliberately: a transaction is a historical
  /// record and must survive the player being deleted. Losing the link is
  /// acceptable; losing the fact that the signing happened is not.
  playerId   String?
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)

  headline   String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([leagueId, seasonYear, week])
  /// "Everything that ever happened to this man", which is the read the column
  /// exists to serve — his page, and the provenance panel behind it.
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Unsolicited AI trade offers — the CPU approaching the user, not the other
// way around. Persisted (rather than generated fresh per page load) so an
// offer survives a refresh and the user can act on it whenever they get to
// the Trade screen, not just the instant it was generated.
// ---------------------------------------------------------------------------

model TradeOffer {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  fromTeamId String
  fromTeam   Team   @relation(fields: [fromTeamId], references: [id], onDelete: Cascade)
  toTeamId   String // always the user's team for now — AI-to-AI offers aren't surfaced

  give    String @default("[]") // JSON TradeAsset[] — what fromTeam is offering
  request String @default("[]") // JSON TradeAsset[] — what fromTeam wants back
  blurb   String

  status     String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | EXPIRED
  seasonYear Int
  week       Int
  createdAt  DateTime @default(now())

  @@index([leagueId, toTeamId, status])
}

// ---------------------------------------------------------------------------
// Franchise history. Team.wins/losses etc. reset every offseason (see
// lib/season.ts RESET_STANDINGS), so this is the only place a season's
// result survives past the year it happened — captured the moment the
// championship game completes, right before that reset runs.
// ---------------------------------------------------------------------------

model TeamSeasonRecord {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  year          Int
  wins          Int
  losses        Int
  ties          Int
  pointsFor     Int
  pointsAgnst   Int
  // MISSED | WILDCARD | DIVISIONAL | CONFERENCE | RUNNER_UP | CHAMPION
  playoffResult String @default("MISSED")

  @@unique([teamId, year])
  @@index([leagueId, year])
}

// One player's production in one season for ONE club — the row behind the
// year-by-year stat table on the player page (see docs/player-seasons.md).
//
// Keyed on (player, year, TEAM) rather than (player, year) on purpose: a
// player traded mid-season gets one row per club, because "which club did he
// produce for" is the question a year-by-year table exists to answer, and one
// row averaged across two jerseys answers it wrongly while looking
// authoritative. The display re-combines them into a "2TM" summary line above
// the pair, the way every real football reference does.
//
// Written once a year by rollSeasonStatsIntoCareer() in lib/season.ts, from
// played box scores rather than from Player.seasonStats — the box scores are
// the only place the club-he-played-for-that-year exists at all. Player.
// seasonStats and Player.careerStats are merged blobs with no season and no
// team on them, which is why this table had to exist. See lib/playerSeasons.ts
// for what is and isn't knowable, and why nothing here is ever invented.
model PlayerSeason {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  seasonYear Int

  // The club he played for THAT year — the entire point of the row. Nullable
  // only so a deleted Team can't take the row with it; teamAbbr is
  // denormalized alongside so the crest and the label survive that, the same
  // reason LeagueRecord and TradeRecord denormalize theirs.
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamAbbr String

  // His age that season. Nullable, and null is a real answer rather than a
  // missing one — see ageInSeason() in lib/playerSeasons.ts. A dash is honest
  // where the arithmetic can't be trusted; a fabricated 24 is not.
  age Int?

  // Regular-season games played. `playoffGp` below counts the postseason ones
  // — separately, because a column headed "G" next to regular-season yardage
  // has to count the games those yards came from.
  gp Int @default(0)

  // Where his FIRST game for this club fell in the season, as a sortable
  // position (playoff weeks restart at 1, so they are offset past the regular
  // season). Only ever matters for a player traded mid-year: without it the
  // two rows of a split season come back in whatever order Postgres feels
  // like, and the table would say he played for the new club first. Ordering
  // by insertion or by id would have worked by accident of how cuids are
  // generated; this works on purpose. Defaulted rather than nullable so the
  // sort key is never NULL.
  firstSeen Int @default(0)

  // JSON string, SeasonStats (lib/types.ts) — the same shape and the same keys
  // the box score wrote. REGULAR SEASON ONLY; see Player.seasonStats for why
  // the two buckets are separate.
  stats String @default("{}")

  // The postseason half of the same season, same shape. Zero-valued for the
  // twenty clubs a year that don't get one, which is a real answer and is
  // rendered as one ("no postseason games") rather than as a row of zeroes.
  playoffStats String @default("{}")
  playoffGp    Int    @default(0)

  // The query this table exists to serve is "every season for one player,
  // oldest first", which this unique index serves as a prefix scan. It is also
  // the idempotency key: re-running a rollover cannot double a season.
  @@unique([playerId, seasonYear, teamAbbr])
  // For the per-league sweep — which years already have rows, and the
  // delete-and-rewrite of a single year.
  @@index([leagueId, seasonYear])
}

// Single-season and career statistical highs, checked/updated once per
// season during the offseason stats rollover (see lib/records.ts). One row
// per (leagueId, scope, category) — the current holder, not full history.
model LeagueRecord {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  scope      String // SEASON | CAREER
  category   String // e.g. "passYds", "sacks" — matches SeasonStats keys
  value      Int
  playerId   String
  playerName String // denormalized — a retired/traded holder still displays correctly
  teamAbbr   String // team the record was set with (denormalized, same reason)
  seasonYear Int // season the record was set in (SEASON) or last improved in (CAREER)

  @@unique([leagueId, scope, category])
  @@index([leagueId])
}

// A snapshot of exactly what was traded and what it was worth at the time —
// the plain Transaction row for a trade only ever recorded asset COUNTS
// ("sends 2 asset(s)"), never identities, so there was nothing to grade
// retrospectively. One row per trade, independent of the Transaction feed.
// See lib/tradeRetro.ts for how this gets turned into a "who won this
// trade" verdict later.
model TradeRecord {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  seasonYear Int
  week       Int
  teamAId    String
  teamBId    String
  teamAAbbr  String // denormalized — a team can be renamed/relocated later (not currently supported, but cheap insurance)
  teamBAbbr  String

  // JSON string TradeAssetSnapshot[] (see lib/tradeRetro.ts) — what A sent to
  // B, and what B sent to A, each priced with the same neutral (no team
  // need/context) valuation used everywhere else, at the moment of the trade.
  aToB String
  bToA String

  createdAt DateTime @default(now())

  @@index([leagueId, createdAt])
}

// ---------------------------------------------------------------------------
// DYNASTY / GM PROGRESSION  (see lib/dynasty.ts)
// ---------------------------------------------------------------------------
/// The only PERSISTED half of the Dynasty system. Dynasty XP and level are
/// NOT stored: they are recomputed on every read as a pure function of
/// history the database already holds (TeamSeasonRecord, CHAMPION/AWARD_*
/// Transaction rows, DraftPick -> Player). That keeps XP self-healing for
/// saves that predate this feature, impossible to farm by repeating an
/// action, and — the reason it is worth doing this way — requires no hook in
/// lib/season.ts at all.
///
/// What genuinely cannot be derived, and therefore lives here:
///   - which skills the GM chose to buy (`skills`)
///   - how many Scout Now charges have been burned this league year
///
/// OWNER SHAPE. Today there is exactly one row per league and `ownerKind` is
/// always "LEAGUE". The pair (ownerKind, ownerKey) is the real key; leagueId
/// is a convenience relation that a future account-wide mode would simply
/// leave null. Nothing reads leagueId except the lookup helper, so switching
/// to per-account progression later is a resolver change, not a rewrite.
model DynastyProfile {
  id String @id @default(cuid())

  // "LEAGUE" today. "ACCOUNT" would key on a user id instead. [TUNE-later]
  ownerKind String @default("LEAGUE")
  // == leagueId while ownerKind is "LEAGUE".
  ownerKey  String

  leagueId String? @unique
  league   League? @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  /// JSON string map of skillId -> rank purchased, e.g. {"EVALUATIONS":2}.
  /// Absent key == rank 0. See lib/dynasty.ts DYNASTY_SKILLS.
  skills String @default("{}")

  /// FULL SCOUT charge ledger. `fullScoutYear` is the league year the counter
  /// applies to; when League.seasonYear moves past it the counter is treated
  /// as 0 (and rewritten on the next spend), which is how "resets on a new
  /// season" works without a season hook. The allowance itself is a baseline
  /// entitlement (DYNASTY.FULL_SCOUT_BASE_USES) plus the Scouting Network
  /// upgrade — it is NOT stored, so retuning it applies to every save at once.
  fullScoutYear Int @default(0)
  fullScoutUsed Int @default(0)

  /// Same ledger for the Negotiation branch's once-or-twice-a-season Insider
  /// ability, kept separate so the two scarcities are tuned independently.
  insiderYear Int @default(0)
  insiderUsed Int @default(0)

  /// PRIVATE WORKOUT slot ledger (see lib/workouts.ts), same year-stamped
  /// shape as the two above and for the same reason: a counter tagged with
  /// the league year it belongs to reads as zero the moment the year moves,
  /// so "resets every season" needs no hook to be CORRECT. lib/season.ts
  /// zeroes it at the season boundary anyway, purely so the count on screen
  /// turns over with the calendar instead of on the next spend.
  workoutYear Int @default(0)
  workoutUsed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerKind, ownerKey])
}

// ---------------------------------------------------------------------------
// Contract negotiation (server-authoritative)
// ---------------------------------------------------------------------------

/// How much patience a GM has already burned in one negotiation.
///
/// Patience is the loss condition of the contract minigame: every offer he
/// turns down costs a pip, a genuine lowball costs two, and when they run out
/// his agent stops taking calls — on the open market he signs with whoever
/// else is bidding and he is gone for good. That only means anything if it
/// SURVIVES. The first version passed the count up from the browser, so
/// pressing F5 reset it to zero and a GM could lowball the same free agent
/// forever. That is the "they accept everything" behaviour this whole minigame
/// was built to remove, wearing a slider.
///
/// So the count lives here, and the server is the only thing that ever writes
/// it. The client does not send a count at all — it renders whatever the
/// server hands back (see `negotiateOffer` in lib/freeagency.ts).
///
/// KEYED ON (team, player, league year), which is exactly the set of things
/// that make a negotiation the same negotiation:
///   - a new league year is a new negotiation — new asking price, new market —
///     so the year is part of the key, and prior-year rows are pruned;
///   - him signing anywhere deletes his rows, so a player who is cut and
///     comes back to the market starts fresh;
///   - reloading, navigating away, or restarting the server change nothing.
///
/// WHAT THIS DELIBERATELY DOES NOT STORE: a row per opened panel. A row is
/// written only when patience is actually SPENT. A GM who opens talks with
/// forty free agents and walks away from all forty writes nothing at all —
/// opening the panel is free, and it should be, because it is free in the
/// fiction too. With the prior-year prune on every write, the table is bounded
/// by "negotiations you actually made an offer in, this league year".
///
/// "Walked away" is NOT a column: it is `patienceSpent >= ctx.patience`,
/// re-derived from the live context every time. Storing it would be a second
/// source of truth for one fact, and the two would drift the first time a
/// player's patience moved — which it does, with rival interest.
model NegotiationTalks {
  id String @id @default(cuid())

  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// The league year these talks belong to. Part of the key, not a stamp.
  seasonYear Int

  /// Pips burned so far. Never decreases within a league year.
  patienceSpent Int @default(0)

  /// SET ASIDE — "not now", on the re-sign list. Null means he is still on the
  /// list to be worked; a timestamp means the GM has parked him so a twenty-deep
  /// list can be triaged top to bottom.
  ///
  /// It is NOT "let him walk" (that decision is its own control on the row, and
  /// it releases him), and it costs no patience — nothing in lib/negotiation.ts
  /// reads this column, so parking a man cannot change what he will sign for.
  /// It lives here rather than in its own table because the key this model
  /// already has — team + player + league year — is exactly the scope of the
  /// decision, so it expires on its own when the year rolls over, which is what
  /// "revisit during the offseason re-sign phase" means and nothing more.
  ///
  /// Whoever is still set aside when the RESIGN phase ends is named and counted
  /// in the advance warning (lib/season.ts) before anybody is allowed to walk.
  dismissedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([teamId, playerId, seasonYear])
  @@index([leagueId, seasonYear])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Accounts — see docs/accounts.md for the design, lib/auth.ts for the
// mechanism and lib/owner.ts for what ownership means once an account exists.
// ---------------------------------------------------------------------------

model User {
  id          String @id @default(cuid())
  /// As typed, for display. Uniqueness is enforced on usernameKey, not here.
  username    String @unique
  /// username.toLowerCase() — the actual lookup key, so "Habib" and "habib"
  /// cannot both exist. Postgres has no case-insensitive unique index without
  /// citext or a functional index and Prisma models neither portably, so a
  /// second column is the boring, migratable way to say the same thing.
  usernameKey String @unique

  /// Nullable, unique, and NEVER collected by the sign-up form today. It is
  /// here so that adding a Discord login (which supplies one) or an opt-in
  /// recovery address later is a write rather than a migration. An unverified
  /// address is not a recovery mechanism, so asking for one now would be a
  /// promise the app cannot keep — see docs/accounts.md §4.
  email String? @unique

  /// scrypt, in the versioned self-describing format lib/password.ts writes.
  /// NULLABLE on purpose: an OAuth-only account has no password, and putting a
  /// hash-shaped placeholder in a column where "no password set" is the
  /// truthful answer is how a login path grows a bug.
  passwordHash String?

  /// PUBLIC LEADERBOARD CONSENT. Default false, and the default is the whole
  /// point: a beta tester who signs up to keep their saves has not agreed to
  /// have their username and their franchise's record published on a page
  /// anyone can read. Opting in is one toggle on /account; opting out deletes
  /// every DynastyRank row this account has, rather than merely hiding them.
  ///
  /// Defaulted rather than nullable so the column is a boolean everywhere and
  /// `migrate deploy` can add it to a table with live rows — an existing
  /// account lands on false, which is the answer nobody has to be asked for.
  leaderboardOptIn Boolean @default(false)

  createdAt DateTime @default(now())

  sessions Session[]
  leagues  League[]
  ranks    DynastyRank[]
}

/// Server-side sessions. The cookie carries a random 32-byte token; this table
/// stores only its SHA-256, so a database dump contains no usable session.
/// (SHA-256 is right HERE and wrong for a password: the token already has 256
/// bits of entropy, so there is no dictionary to run and no salt to add.)
///
/// A table rather than a JWT because sign-out has to actually invalidate.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  expiresAt  DateTime
  /// Bumped at most once a day, so a sliding expiry is not a write on every
  /// request of every page.
  lastSeenAt DateTime @default(now())

  /// Diagnostics only. NEVER consulted when deciding whether a session is
  /// valid — a session is valid because its token hashes to a live row, not
  /// because the request looked familiar.
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

/// Rate-limit ledger for sign-in and sign-up. Postgres rather than Redis: this
/// deployment has one database, and a COUNT over an indexed time window
/// answers the question correctly. A second stateful dependency that could be
/// down — failing every login, or failing open — is worse than this.
model AuthAttempt {
  id String @id @default(cuid())

  /// The bucket being counted. "u:<usernameKey>" throttles an attack on one
  /// account; "ip:<addr>" throttles one source spraying many. Both are checked
  /// on every sign-in, because they stop different attacks.
  scope   String
  kind    String /// SIGNIN | SIGNUP
  success Boolean  @default(false)
  at      DateTime @default(now())

  @@index([scope, kind, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Public leaderboard (see lib/leaderboard.ts)
// ---------------------------------------------------------------------------

// One row per FRANCHISE that is eligible to appear on the public board.
//
// WHY A TABLE AT ALL, when Dynasty XP is famously derived and never stored.
// Because a board has to ORDER BY something across every save in the database
// at once, and re-deriving XP per league is a handful of queries per league.
// This table is a MATERIALISATION, not a second source of truth: every row is
// rewritten from `computeDynastyXp` by refreshFootballRanks() in the same
// request that renders the board, and any row whose save has been deleted,
// unclaimed, or opted out is deleted rather than left to go stale.
//
// WHY THERE IS NO `level` COLUMN, and this is the load-bearing decision:
// a stored level is a number that can disagree with `levelFromXp`, and this
// project has shipped exactly that bug more than once. So the level is never
// stored — it is computed from `xp` at render time by the same function the
// Dynasty screen calls. Ordering by xp and ordering by level are the same
// ordering (the curve is monotonic), so nothing is lost.
//
// WHY IT IS NOT KEYED ON League. The owner wants football, baseball and
// basketball feeding one board. `sport` is the discriminator and `saveKey` is
// deliberately a plain String rather than a foreign key to League, so a second
// game can insert its own rows without this schema knowing anything about its
// save table. What the sports SHARE is `User` — identity lives on the account,
// so adding a sport is new rows, never a migration of the identity model.
// The cost of the missing foreign key is that orphan cleanup is the refresh
// sweep's job rather than the database's; that sweep is tested.
model DynastyRank {
  id String @id @default(cuid())

  /// Which game produced this row. "FOOTBALL" today. Never hardcoded in the
  /// board query — the sport tabs are derived from the sports actually present.
  sport String

  /// The save's id in that sport's own id space. For FOOTBALL this is League.id.
  saveKey String

  /// The account this franchise belongs to. Cascade: deleting an account must
  /// take its public rows with it, unlike League.userId which deliberately
  /// leaves the save behind.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The XP total `computeDynastyXp` returned. The ONLY ranking input.
  xp Int @default(0)

  /// The denominator, shown on every row. A level with no seasons beside it is
  /// a number without a unit — see the honesty note on the board itself.
  seasons       Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  championships Int @default(0)

  /// Enough identity to render the franchise the way the rest of the app does:
  /// a crest, a city and a nickname. `crestSeed` is whatever that sport's logo
  /// generator takes (Team.id here).
  teamName  String
  teamAbbr  String
  crestSeed String

  updatedAt DateTime @updatedAt

  /// One row per save. The upsert in refreshFootballRanks() targets this.
  @@unique([sport, saveKey])
  /// The board's read: everything for a sport, best first.
  @@index([sport, xp])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Weekly power rankings (see lib/powerRankings.ts and docs/power-rankings.md).
//
// This table exists for ONE reason: movement cannot be recomputed. A team's
// rating depends on the roster as it is right now, so a club that signed a
// free agent on Tuesday would retroactively rewrite what it was ranked on
// Sunday. "Up 4 from last week" is only honest if last week was written down
// last week — which is what this is.
// ---------------------------------------------------------------------------

model PowerRankingSnapshot {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  seasonYear Int
  // The week these rankings were published FOR — i.e. entering this week.
  // The postseason resets League.week to 1 for four rounds, so everything from
  // the playoffs on maps to one terminal week (seasonLength + 1): the final
  // regular-season ranking, which stops moving because nothing behind it moves.
  // Offseason phases are never snapshotted — they reuse week numbers across
  // five phases and every record is 0-0 anyway.
  week       Int
  rank       Int // 1-32, the ordering that was actually displayed
  powerIndex Float // the published index, league average 50
  rating     Int // buildLeagueRatings().overall at the time
  wins       Int
  losses     Int
  ties       Int
  netPerGame Float

  createdAt DateTime @default(now())

  // One row per club per league-week, which is what makes the write
  // idempotent: ensurePowerSnapshot() uses createMany({ skipDuplicates: true }),
  // so two concurrent renders cannot produce two versions of the same week and
  // a week already on record is never rewritten. The whole point of a snapshot
  // is that it says what we thought THEN.
  @@unique([leagueId, seasonYear, week, teamId])
  @@index([leagueId, seasonYear, week])
}
